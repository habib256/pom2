# POM2 compatibility corpus (VALIDATION-006) — the titles pom2_corpus boots.
# Grammar and workflow: tests/corpus/README.md. Media paths are relative to
# the source tree; a title whose media is absent is SKIPPED with the reason.

# ── DIX (French Touch, GPL) — the priority benchmark (docs/test_corpus.md).
# The fresh-install map minus what DIX does not touch: Mockingboard A/C in 2
# (DIX scans for it), the 3.5" SmartPort in 5, Le Chat Mauve Féline in 7.
# The menu is up at ~17 s; LEFT wraps choice 0 to 16, "all demos in
# automatic mode", and every part then runs on its own timer. One check ~30 s
# into each part (part starts from dix_auto_tour_probe, 2026-11-06).

title dix-menu iie-pal ci dix
  mockingboard 2
  smartport 1 disks_3.5/DIX-fix.po sha256=e375db9d722454ec1c75dff32386c5d92f15847f8390552acd081a69991e18df
  rgb 7 feline
  run 25
  check menu
  key LEFT
  run 1
  key RETURN
  run 30
  check unlimited-bobs

# The browser's machine: //c PAL, Mockingboard 4c on the internal connector,
# the Chat Mauve adapter. DIGIDREAM SID Voice Edition takes its //c path
# there (IOU VBL interrupt, `LDA $C019 / BPL` with the handler armed) and
# froze on it until 2026-11-07 (CHANGELOG; pinned at unit level by
# vbl_ioudis_annunciator §5). `boot 5` is the //c's explicit SmartPort boot
# (the GUI's Boot button / bootFromSlot(5)): the facade's slot-5 card on a
# //c is the armed $C500 stub, which the ROM's cold-boot scan does not find.
# LEFT twice: 0 -> 16 (automatic) -> 15 = DD2.
title dix-digidream-sid-iic iic-pal ci dix
  boot 5
  mockingboard 4
  smartport 1 disks_3.5/DIX-fix.po sha256=e375db9d722454ec1c75dff32386c5d92f15847f8390552acd081a69991e18df
  rgb 7 iic
  run 25
  check menu
  key LEFT
  run 1
  key LEFT
  run 1
  key RETURN
  run 40
  check digidream-sid-iic

title dix-auto iie-pal dix
  mockingboard 2
  smartport 1 disks_3.5/DIX-fix.po sha256=e375db9d722454ec1c75dff32386c5d92f15847f8390552acd081a69991e18df
  rgb 7 feline
  run 25
  check menu
  key LEFT
  run 1
  key RETURN
  run 30
  check unlimited-bobs           # t = 56 s
  run 118
  check scroll-scroll-scroll     # 174
  run 69
  check crazy-cycles             # 243
  run 124
  check question-of-frames       # 367
  run 76
  check plasmagoria              # 443
  run 103
  check raster-bars              # 546
  run 119
  check crazy-cycles-2           # 665
  run 259
  check one-more-thing           # 924
  run 99
  check mad-effect               # 1023
  run 122
  check mad-effect-2             # 1145
  run 112
  check unreeeal-superhero-3     # 1257
  run 121
  check mad-effect-3             # 1378
  run 44
  check digidream                # 1422
  run 109
  check oldskool-fort-et-vert    # 1531
  run 59
  check digidream-sid            # 1590


include "inc/cmdsys.plh"

word values[5]
word i, total

def square(n)
    return n * n
end

total = 0
for i = 0 to 4
    values[i] = square(i + 1)
next
for i = 0 to 4
    total = total + values[i]
next
if total == 55
    puts("POM2 PLASMA PASS: ")
else
    puts("POM2 PLASMA FAIL: ")
fin
puti(total)
putln()
done

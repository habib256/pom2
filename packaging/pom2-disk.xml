<?xml version="1.0" encoding="UTF-8"?>
<!-- Apple II disk-image MIME type used by POM2.desktop (MimeType=...).
     Installed into share/mime/packages/; `update-mime-database` (run by the
     .deb postinst / the user's desktop) wires the globs to the type so a
     double-clicked disk image opens in POM2. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-apple2-disk">
    <comment>Apple II disk image</comment>
    <comment xml:lang="fr">Image disque Apple II</comment>
    <icon name="POM2"/>
    <generic-icon name="media-floppy"/>
    <glob pattern="*.dsk"/>
    <glob pattern="*.do"/>
    <!-- weight 40 (default is 50): *.po is also gettext's portable-object
         extension, and shared-mime-info resolves a glob collision by
         weight. At the default POM2 could win the tie and hand a
         translator's .po file to an Apple II emulator. ProDOS order
         images are still recognised when nothing else claims the glob. -->
    <glob pattern="*.po" weight="40"/>
    <glob pattern="*.nib"/>
    <glob pattern="*.woz"/>
    <glob pattern="*.d13"/>
    <glob pattern="*.hdv"/>
    <glob pattern="*.2mg"/>
  </mime-type>
</mime-info>

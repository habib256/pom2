build/
build-*/
build_wasm/
# build_wasm.sh stages the browser bundle here; CI deploys it to Pages, it is
# never committed (see ci.yml `pages`).
wasm/index.html
wasm/POM2.js
wasm/POM2.wasm
wasm/POM2.data
wasm/POM2.worker.js
DIST/
imgui/
*.o
*.obj
# A coverage-instrumented binary run from the repo root drops one here.
*.profraw
.cache/
.claude/
compile_commands.json
.vscode/
.idea/
*.swp
.DS_Store

# Debug captures / screenshots (F9 → screenshot_NNN.ppm, X11 xwd dumps)
*.xwd
screenshot_*.ppm

# CMake droppings if someone runs `cmake .` instead of `cmake -B build`
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake
/CTestTestfile.cmake
/Makefile
/Testing/
tests/CMakeFiles/
tests/CMakeCache.txt
tests/cmake_install.cmake
tests/CTestTestfile.cmake
tests/Makefile

# Compiled test executables, if someone configures in-source instead of
# into build/. Every one has an add_executable target in
# tests/CMakeLists.txt, so `cmake .. && make` regenerates the lot. The
# `test_` prefix belongs to the CMake targets only — the sources are
# named <subject>_test.cpp — but keep the negation as insurance.
tests/test_*
!tests/test_*.cpp
tests/c2plus_boot_probe
tests/copy2plus_boot_dump
tests/hero_probe

# Runtime output written by the emulator itself, not source.
/printouts/
/snapshots/

# Virtual ][ commercial recordings, copied locally from a USB key for
# listening tests. The accompanying LISEZMOI forbids redistribution, so
# they stay out of git. packaging/bundle.manifest denies the same folder.
/roms/virtual_ii_sons/

# imagewriter_pdf writes its sheets to a cwd-relative directory. Under ctest
# the cwd is build/ (already ignored), but running the binary by hand from the
# repo root drops it here.
/imagewriter_pdf_test_out/

# Dear ImGui writes its window layout here at runtime.
imgui.ini

# Release staging produced by build_dist.sh / build_appimage.sh.
/build-appimage/
/build-macos/
/build-universal-deps/
/dist/
/squashfs-root/

# Crash debris from an interrupted atomic write-back: `tempSiblingPath` names
# every temporary `<target>.<pid>-<n>.pom2tmp`, and a process killed between
# the write and the rename leaves one behind (the pid in the name means the
# next run never reuses it). `sweepStaleTempSiblings` clears them, but never
# from a directory POM2 has no reason to open.
*.pom2tmp

# No copyrighted firmware and no third-party disk image in the repository
# (2026-10-29). ROMs come from the ROM download (archive.org pom2_roms_202610);
# the test media from tools/fetch_test_media.py (pom2_testmedia). The
# files still tracked under these folders — the author's own GPL software,
# French Touch's GPL DIX, the MAME floppy samples (pic/ holds the author's
# own photos and the MIT drive artwork, and stays tracked as a whole) —
# stay tracked; a NEW one is added with `git add -f` after checking its licence.
/roms/*
!/roms/floppy_samples/
/disks_5.4/
/disks_3.5/
/hdv/
/floppyemu/
/cassettes/
/pic/Apple II Diskware - DOS v3.3 Basics*
/tests/data/cpm/BTERM.COM
